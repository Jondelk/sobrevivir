# Copie este archivo como .env (en la raíz del proyecto) y ajuste los valores.
# No guarde secretos en el repositorio.

# Puerto del servidor (API + Socket.IO + aplicación web compilada)
PORT=3001
HOST=0.0.0.0

# MongoDB para el modo conectado (sesión de aula).
# Sin esta variable el servidor arranca, la demostración local funciona y el
# modo aula indica que requiere configuración.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sobrevivir

# Solo para pruebas automatizadas: almacén en memoria (los datos se pierden al
# reiniciar). NO usar en una sesión real.
# SOBREVIVIR_STORE=memoria-pruebas
