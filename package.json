{
  "name": "sobrevivir-al-mes",
  "private": true,
  "version": "1.0.0",
  "description": "Sobrevivir al mes — Educación financiera para no financieros. Una experiencia educativa de PIXELES.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sobrevivir/web",
    "dev:server": "npm run dev --workspace @sobrevivir/server",
    "build": "npm run build --workspace @sobrevivir/web",
    "start": "npm run start --workspace @sobrevivir/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
